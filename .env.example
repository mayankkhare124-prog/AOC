# ── Server ────────────────────────────────────────────────
PORT=5000
NODE_ENV=development

# ── Database ──────────────────────────────────────────────
# Local MongoDB:      mongodb://127.0.0.1:27017/aoc
# MongoDB Atlas (SaaS, free tier): mongodb+srv://<user>:<pass>@cluster.mongodb.net/aoc
MONGODB_URI=mongodb://127.0.0.1:27017/aoc

# ── Auth ──────────────────────────────────────────────────
JWT_SECRET=replace_this_with_a_long_random_string
JWT_EXPIRES_IN=7d

# ── Admin seed account (used only by `npm run seed`) ───────
ADMIN_EMAIL=admin@aoc-mits.com
ADMIN_PASSWORD=change_this_password_before_seeding

# ── CORS ──────────────────────────────────────────────────
CLIENT_URL=http://localhost:5000
